{
  "expo": {
    "name": "Tread",
    "slug": "tread",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tread",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android"],
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.malomiquel.tread",
      "supportsTablet": false
    },
    "android": {
      "package": "com.malomiquel.tread",
      "adaptiveIcon": {
        "backgroundColor": "#0b1120",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#0b1120", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      "expo-sqlite",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "Tread utilise ta position pour tracer ta course et mesurer ta distance.",
          "locationAlwaysAndWhenInUsePermission": "Tread a besoin de ta position même écran verrouillé pour continuer à enregistrer ta course dans ta poche.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
