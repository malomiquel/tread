{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // RN 0.87+ ships strict types; icon, router and view-shot typings still expect the
    // legacy ones. Drop this once they catch up (the condition goes after RN 0.89).
    "customConditions": ["react-native-legacy-deep-imports"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "live-activity": [
        "./modules/live-activity"
      ],
      "zip-file": [
        "./modules/zip-file"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
