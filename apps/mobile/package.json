    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "release:ios": "npx eas-cli build --platform ios --profile production --local --output dist/tread.ipa && npx eas-cli submit --platform ios --profile production --path dist/tread.ipa",
    "release:android": "npx eas-cli build --platform android --profile production --local --output dist/tread.aab && npx eas-cli submit --platform android --profile production --path dist/tread.aab",
    "postinstall": "patch-package",
    "install:ios": "TREAD_NO_ICLOUD=1 EXPO_USE_PRECOMPILED_MODULES=0 sh -c \"expo prebuild --platform ios --clean && expo run:ios --configuration Release --device 00008110-000459523492401E\"",
    "deploy:ios": "./scripts/deploy-ios.sh"
  },
  "private": true
