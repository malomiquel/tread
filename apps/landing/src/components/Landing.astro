---
import type { Language } from "@tread/core/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../layouts/Base.astro";
import { strings } from "../strings.ts";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const s = strings(language);
const other: Language = language === "fr" ? "en" : "fr";
// Where the web app answers; set at build time for production.
const webUrl = import.meta.env.PUBLIC_WEB_URL ?? "http://localhost:3020";
const distance = language === "fr" ? "8,42" : "8.42";
// One loop of a run, drawn by hand: the shape the hero draws behind the phone.
const track =
  "M120 470 C 60 400, 70 300, 150 260 S 260 250, 300 180 S 380 60, 470 90 S 600 170, 560 270 S 470 330, 500 400 S 600 470, 520 540 S 330 600, 240 560 S 170 520, 120 470 Z";
const ticker = [...s.ticker, ...s.ticker];
const widths = [72, 64, 81, 58, 100];
---

<Base language={language} title={s.title} description={s.description}>
  <header class="bar">
    <a href={getRelativeLocaleUrl(language, "")} class="brand" aria-label="Tread">TREAD<i></i></a>
    <nav>
      <a href={getRelativeLocaleUrl(other, "")} hreflang={other} lang={other} aria-label={s.otherLanguageName} class="lang">{s.otherLanguage}</a>
      <a href={webUrl} class="pill">{s.openWeb}</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="contours" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="kicker"><span class="rec"></span>{s.kicker}</p>
        <h1>
          {s.heroLines.map((line, index) => <span class={`line line-${index}`}>{line}</span>)}
        </h1>
        <p class="lede">{s.lede}</p>
        <div class="actions">
          <a href={webUrl} class="cta">{s.openGpx}<span aria-hidden="true">→</span></a>
          <a href="https://github.com/malomiquel/tread" class="ghost">{s.source}</a>
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <svg class="track" viewBox="0 -40 640 720" preserveAspectRatio="xMidYMid meet">
          <defs>
            <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="6" result="blur" />
              <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>
          <path d={track} class="track-shadow" />
          <path d={track} class="track-line" pathLength="1" filter="url(#glow)" />
          <g class="runner">
            <circle r="16" class="runner-halo" />
            <circle r="8" class="runner-dot" />
            <animateMotion dur="9s" begin="3.6s" repeatCount="indefinite" path={track} />
          </g>
        </svg>
        <span class="flag flag-start">KM 0</span>
        <span class="flag flag-end">KM 8</span>

        <div class="phone">
          <div class="notch"></div>
          <div class="screen">
            <span class="chip">{s.phone.verdict}</span>
            <span class="metric-label">{s.phone.pace}</span>
            <span class="pace">5'12"</span>
            <span class="target">/km · {s.phone.target}</span>
            <div class="gauge"><span class="band"></span><span class="marker"></span></div>
            <div class="block">
              <strong>{s.phone.block}</strong>
              <span>{s.phone.left}</span>
              <span class="next">{s.phone.next}</span>
            </div>
            <div class="figures">
              <div><span class="metric-label">{s.phone.distance}</span><b>{distance}<small>km</small></b></div>
              <div><span class="metric-label">{s.phone.time}</span><b>43:51</b></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-run">
        {ticker.map((item) => <span>{item}<em>/</em></span>)}
      </div>
    </div>

    <section class="splits">
      <div class="splits-head">
        <p class="kicker dark">{s.splitsKicker}</p>
        <h2>{s.splitsTitle}</h2>
      </div>
      <ol>
        {s.splits.map((split, index) => (
          <li class="split" style={`--w: ${widths[index]}%`}>
            <span class="km">KM {String(index + 1).padStart(2, "0")}</span>
            <div class="split-copy">
              <h3>{split.title}</h3>
              <p>{split.text}</p>
            </div>
            <span class="split-figure">{split.figure}</span>
            <span class={`split-bar${index === s.splits.length - 1 ? " now" : ""}`}></span>
          </li>
        ))}
      </ol>
    </section>

    <section class="rival">
      <p class="kicker">{s.ghostKicker}</p>
      <div class="ghost-grid">
        <h2>{s.ghostTitle.map((line, index) => <span class={index === 2 ? "accent" : ""}>{line}</span>)}</h2>
        <div class="ghost-side">
          <div class="lane" aria-hidden="true">
            <div class="lane-track">
              <span class="lane-runner record"><em>{s.ghostRecord}</em></span>
              <span class="lane-runner you"><em>{s.ghostYou}</em></span>
            </div>
            <div class="gap"><b>{s.ghostGap}</b><span>{s.ghostGapLabel}</span></div>
          </div>
          <p>{s.ghostText}</p>
        </div>
      </div>
    </section>

    <section class="more">
      <p class="kicker">{s.moreKicker}</p>
      <h2>{s.moreTitle}</h2>
      <div class="bento">
        {s.more.map((item, index) => (
          <article class={`tile tile-${index}`}>
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="final">
      <h2>{s.finalTitle}</h2>
      <p>{s.finalText}</p>
      <a href={webUrl} class="cta light">{s.openGpx}<span aria-hidden="true">→</span></a>
    </section>
  </main>

  <footer class="foot">
    <span class="brand small">TREAD<i></i></span>
    <span>{s.footer}</span>
    <span>© {new Date().getFullYear()}</span>
  </footer>
</Base>

<style>
  /* Gutter 20 on a phone, wider on a desk; type and radii from DESIGN.md. */
  :root { --edge: clamp(20px, 5vw, 64px); }
  .bar {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px var(--edge);
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--ink-rule) 60%, transparent);
  }
  .brand { font-weight: 900; font-style: italic; font-size: 26px; letter-spacing: -0.5px; display: inline-flex; align-items: center; gap: 4px; }
  .brand i { width: 9px; height: 9px; border-radius: 50%; background: var(--signal); display: inline-block; margin-top: 8px; }
  .brand.small { font-size: 20px; }
  nav { display: flex; align-items: center; gap: 18px; }
  .lang { font-weight: 600; font-size: 15px; letter-spacing: 1.3px; color: var(--chalk-muted); padding: 8px 4px; }
  .lang:hover { color: var(--chalk); }
  .pill {
    height: 36px; padding: 0 16px; border-radius: 18px; display: inline-flex; align-items: center;
    background: var(--signal); color: var(--on-signal); font-weight: 600; font-size: 16px;
    transition: transform 90ms ease-out;
  }
  .pill:active, .cta:active, .ghost:active { transform: scale(0.96); transition-duration: 160ms; }

  .kicker {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px;
    font-size: 13px; font-weight: 600; letter-spacing: 2.4px; text-transform: uppercase; color: var(--chalk-subtle);
  }
  .kicker.dark { color: var(--graphite-muted); }
  .rec { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); animation: pulse 1.6s ease-in-out infinite; }

  /* Hero */
  .hero {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; gap: 24px;
    min-height: calc(100svh - 65px); padding: 48px var(--edge) 72px;
  }
  .contours {
    position: absolute; inset: -20%; opacity: 0.5; pointer-events: none;
    background:
      repeating-radial-gradient(ellipse at 78% 46%, transparent 0 38px, color-mix(in srgb, var(--chalk) 7%, transparent) 38px 39px),
      radial-gradient(ellipse at 78% 46%, color-mix(in srgb, var(--cobalt) 55%, transparent), transparent 55%);
    mask-image: radial-gradient(ellipse at 70% 50%, black 30%, transparent 75%);
  }
  .hero-copy { position: relative; z-index: 2; }
  h1 {
    margin: 0 0 26px; font-weight: 900; font-style: italic; text-transform: uppercase;
    font-size: clamp(56px, 7.6vw, 128px); line-height: 0.84; letter-spacing: -0.02em; white-space: nowrap;
  }
  .line { display: block; animation: arrive 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .line-1 { animation-delay: 90ms; -webkit-text-stroke: 2px var(--chalk); color: transparent; }
  .line-2 { animation-delay: 180ms; color: var(--signal); }
  .lede { max-width: 36ch; font-size: clamp(18px, 1.6vw, 22px); color: var(--chalk-muted); margin: 0 0 34px; animation: arrive 700ms 260ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; animation: arrive 700ms 330ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .cta {
    display: inline-flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 26px; border-radius: 6px;
    background: var(--signal); color: var(--on-signal); font-weight: 700; font-size: 19px; letter-spacing: 0.3px;
    transition: transform 90ms ease-out, gap 200ms ease;
  }
  .cta:hover { gap: 22px; }
  .cta.light { background: var(--paper); color: var(--graphite); }
  .ghost {
    display: inline-flex; align-items: center; min-height: 56px; padding: 0 22px; border-radius: 6px;
    border: 1px solid var(--ink-rule); color: var(--chalk); font-weight: 600; font-size: 18px; transition: transform 90ms ease-out;
  }
  .ghost:hover { border-color: var(--chalk-subtle); }

  .stage { position: relative; aspect-ratio: 5 / 6; width: min(100%, 600px); justify-self: center; }
  .track { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .track-shadow { fill: none; stroke: color-mix(in srgb, var(--chalk) 8%, transparent); stroke-width: 14; stroke-linejoin: round; }
  .track-line {
    fill: none; stroke: var(--signal); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 3.2s 400ms cubic-bezier(0.6, 0.1, 0.3, 1) forwards;
  }
  .runner { opacity: 0; animation: appear 1ms 3.6s forwards; }
  .runner-halo { fill: color-mix(in srgb, var(--signal) 35%, transparent); }
  .runner-dot { fill: var(--chalk); }
  .flag {
    position: absolute; font-size: 12px; font-weight: 600; letter-spacing: 1.4px; color: var(--chalk-subtle);
    padding: 4px 8px; border: 1px solid var(--ink-rule); border-radius: 8px; background: var(--ink);
  }
  .flag-start { left: 4%; top: 70%; }
  .flag-end { right: 2%; top: 12%; }

  .phone {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; rotate: -6deg;
    height: 92%; aspect-ratio: 9 / 19; border-radius: 44px; padding: 12px;
    background: linear-gradient(160deg, #2a2a2e, #0e0e10 40%);
    box-shadow: 0 0 0 1px #3a3a3f inset, 0 40px 80px -20px rgba(0, 0, 0, 0.7), 0 0 120px -30px var(--cobalt);
    animation: rise 900ms 200ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .notch { position: absolute; top: 22px; left: 50%; translate: -50% 0; width: 32%; height: 24px; border-radius: 12px; background: #000; z-index: 2; }
  .screen {
    height: 100%; border-radius: 34px; background: var(--ink); overflow: hidden;
    display: flex; flex-direction: column; padding: 58px 18px 20px; gap: 4px; font-variant-numeric: tabular-nums;
  }
  .chip {
    align-self: flex-start; padding: 4px 10px; border-radius: 8px; margin-bottom: 14px;
    background: color-mix(in srgb, var(--signal) 18%, transparent); color: var(--signal); font-size: 13px; font-weight: 600;
  }
  .metric-label { font-size: 10.5px; font-weight: 600; letter-spacing: 1.3px; text-transform: uppercase; color: var(--chalk-subtle); }
  .pace { font-size: clamp(56px, 6vw, 80px); line-height: 0.95; font-weight: 700; letter-spacing: -1.5px; }
  .target { font-size: 14px; color: var(--chalk-muted); }
  .gauge { position: relative; height: 8px; border-radius: 4px; margin: 18px 0 20px; background: var(--ink-rule); }
  .band { position: absolute; left: 38%; width: 24%; top: 0; bottom: 0; border-radius: 4px; background: color-mix(in srgb, var(--signal) 40%, transparent); }
  .marker {
    position: absolute; top: -5px; width: 4px; height: 18px; border-radius: 2px; background: var(--chalk);
    left: 50%; animation: sway 2.8s ease-in-out infinite;
  }
  .block { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-top: 1px solid var(--ink-rule); font-size: 14px; color: var(--chalk-muted); }
  .block strong { color: var(--chalk); font-size: 16px; font-weight: 600; }
  .block .next { color: var(--chalk-subtle); }
  .figures { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding-top: 12px; border-top: 1px solid var(--ink-rule); }
  .figures div { display: flex; flex-direction: column; }
  .figures b { font-size: 26px; font-weight: 600; letter-spacing: -0.5px; }
  .figures small { font-size: 13px; color: var(--chalk-subtle); margin-left: 3px; font-weight: 500; }

  /* Ticker */
  .ticker { background: var(--cobalt); color: #fff; overflow: hidden; border-block: 1px solid color-mix(in srgb, #fff 18%, transparent); }
  .ticker-run { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .ticker span {
    display: inline-flex; align-items: center; gap: 28px; padding: 18px 0 18px 28px; white-space: nowrap;
    font-weight: 800; font-style: italic; text-transform: uppercase; font-size: clamp(22px, 2.6vw, 34px); letter-spacing: 0.5px;
  }
  .ticker em { font-style: normal; opacity: 0.45; }

  /* Splits, on the day side */
  .splits { background: var(--paper); color: var(--graphite); padding: clamp(64px, 10vw, 128px) var(--edge); }
  .splits-head { display: grid; gap: 4px; margin-bottom: 40px; }
  h2 { margin: 0; font-weight: 900; font-style: italic; text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.9; }
  .splits h2 { font-size: clamp(44px, 6.4vw, 96px); max-width: 14ch; }
  ol { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--graphite); }
  .split {
    position: relative; display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 24px;
    padding: 26px 0 30px; border-bottom: 1px solid var(--paper-rule);
  }
  .km { font-size: 14px; font-weight: 600; letter-spacing: 1.6px; color: var(--graphite-muted); font-variant-numeric: tabular-nums; }
  .split h3 { margin: 0 0 4px; font-size: clamp(24px, 2.4vw, 32px); font-weight: 700; letter-spacing: -0.3px; }
  .split p { margin: 0; max-width: 54ch; color: var(--graphite-muted); font-size: 16.5px; }
  .split-figure {
    font-size: clamp(36px, 5vw, 72px); font-weight: 800; font-style: italic; letter-spacing: -1px;
    font-variant-numeric: tabular-nums; color: var(--graphite); transition: color 200ms ease;
  }
  .split-bar {
    position: absolute; left: 134px; bottom: 12px; height: 4px; width: 0; max-width: calc(100% - 134px);
    border-radius: 2px; background: var(--paper-rule); transition: width 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .split-bar.now { background: var(--cobalt); }
  .split:hover .split-figure { color: var(--cobalt); }
  .split .split-bar { width: calc(var(--w) * 0.8); }

  /* The ghost, back to night */
  .rival { padding: clamp(72px, 11vw, 144px) var(--edge); border-bottom: 1px solid var(--ink-rule); }
  .ghost-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .rival h2 { font-size: clamp(52px, 7.6vw, 120px); }
  .rival h2 span { display: block; }
  .rival h2 .accent { color: transparent; -webkit-text-stroke: 2px var(--signal); }
  .ghost-side { display: grid; gap: 28px; }
  .ghost-side p { margin: 0; font-size: clamp(18px, 1.5vw, 21px); color: var(--chalk-muted); max-width: 44ch; }
  .lane { padding: 26px 22px 22px; border-radius: 16px; background: var(--ink-raised); border: 1px solid var(--ink-rule); }
  .lane-track {
    position: relative; height: 96px; margin: 0 8px;
    background: linear-gradient(90deg, var(--ink-rule) 0 0) center / 100% 2px no-repeat,
      repeating-linear-gradient(90deg, var(--ink-rule) 0 1px, transparent 1px 10%) center / 100% 14px no-repeat;
  }
  .lane-runner {
    position: absolute; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%;
    animation: race 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .lane-runner em {
    position: absolute; left: 50%; translate: -50% 0; white-space: nowrap; font-style: normal;
    font-size: 12px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase;
  }
  .lane-runner.record { border: 2px dashed var(--chalk-subtle); --lead: 0%; }
  .lane-runner.record em { top: 26px; color: var(--chalk-subtle); }
  .lane-runner.you { background: var(--signal); box-shadow: 0 0 22px var(--signal); --lead: 9%; }
  .lane-runner.you em { bottom: 26px; color: var(--signal); }
  .gap { display: flex; align-items: baseline; gap: 8px; margin-top: 18px; font-variant-numeric: tabular-nums; }
  .gap b { font-size: 56px; font-weight: 800; font-style: italic; color: var(--signal); letter-spacing: -0.5px; }
  .gap span { color: var(--chalk-muted); font-size: 16px; }

  /* The rest, as tiles */
  .more { padding: clamp(72px, 11vw, 144px) var(--edge); }
  .more h2 { font-size: clamp(44px, 6vw, 92px); max-width: 16ch; margin-bottom: 40px; }
  .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .tile {
    grid-column: span 2; display: flex; flex-direction: column; gap: 8px; min-height: 230px;
    padding: 22px; border-radius: 16px; background: var(--ink-raised); border: 1px solid var(--ink-rule);
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .tile:hover { border-color: color-mix(in srgb, var(--signal) 50%, transparent); transform: translateY(-3px); }
  .tile-0, .tile-1 { grid-column: span 3; }
  .tile-0 { background: radial-gradient(120% 120% at 100% 0%, color-mix(in srgb, var(--cobalt) 55%, transparent), transparent 60%), var(--ink-raised); }
  .tag {
    align-self: flex-start; margin-bottom: auto; padding: 4px 10px; border-radius: 8px;
    font-size: 12px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase;
    color: var(--signal); background: color-mix(in srgb, var(--signal) 14%, transparent);
  }
  .tile h3 { margin: 28px 0 0; font-size: clamp(24px, 2.2vw, 30px); font-weight: 800; font-style: italic; text-transform: uppercase; letter-spacing: -0.2px; line-height: 0.95; }
  .tile p { margin: 0; color: var(--chalk-muted); font-size: 16px; }

  /* The last word, on cobalt */
  .final {
    position: relative; overflow: hidden; background: var(--cobalt); color: #fff;
    padding: clamp(72px, 11vw, 140px) var(--edge); display: grid; justify-items: start; gap: 18px;
  }
  .final::after {
    content: ""; position: absolute; right: -10%; top: -40%; width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: repeating-radial-gradient(circle, transparent 0 34px, rgba(255, 255, 255, 0.16) 34px 35px);
    pointer-events: none;
  }
  .final h2 { font-size: clamp(60px, 10vw, 160px); position: relative; }
  .final p { margin: 0 0 14px; font-size: clamp(18px, 1.6vw, 22px); color: rgba(255, 255, 255, 0.8); max-width: 40ch; position: relative; }
  .final .cta { position: relative; }

  .foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    padding: 28px var(--edge) 40px; color: var(--chalk-subtle); font-size: 14px;
  }
  .foot .brand { color: var(--chalk); }

  /* Scroll reveals where the browser can tie an animation to the view; elsewhere everything is simply there. */
  @supports (animation-timeline: view()) {
    .split, .rival h2 span, .tile, .final h2 {
      animation: arrive linear both; animation-timeline: view(); animation-range: entry 0% entry 60%;
    }
    .split .split-bar { animation: grow linear both; animation-timeline: view(); animation-range: entry 20% cover 45%; }
  }

  @keyframes arrive { from { transform: translateX(-48px); clip-path: inset(-20% 100% -20% 0); } to { transform: none; clip-path: inset(-20% -100vw -20% 0); } }
  @keyframes rise { from { transform: translateY(80px); } to { transform: none; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes appear { to { opacity: 1; } }
  @keyframes sway { 0%, 100% { left: 44%; } 50% { left: 56%; } }
  @keyframes slide { to { transform: translateX(-50%); } }
  @keyframes pulse { 50% { opacity: 0.25; } }
  @keyframes grow { from { width: 0; } }
  @keyframes race { 0% { left: var(--lead); } 85%, 100% { left: calc(82% + var(--lead)); } }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 28px; }
    .stage { width: min(100%, 440px); margin-top: 8px; }
    .ghost-grid { grid-template-columns: 1fr; gap: 36px; }
    .bento { grid-template-columns: 1fr; }
    .tile, .tile-0, .tile-1 { grid-column: auto; min-height: 0; }
    .split { grid-template-columns: 1fr auto; gap: 8px 16px; }
    .km { grid-column: 1 / -1; }
    .split-bar { left: 0; max-width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .track-line { stroke-dashoffset: 0; }
    .runner { opacity: 0; }
  }
</style>
