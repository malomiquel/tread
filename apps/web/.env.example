# Copy to .env.local (never committed).

# Better Auth. The secret: `openssl rand -base64 32`. The URL: where this app
# answers (port 3020 in development, never 3000).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3020"

# Supabase, through the transaction pooler (port 6543). Migrations use
# DIRECT_URL, set in packages/db/.env.
DATABASE_URL=""

# E-mail (verification, password reset) through Resend. Without a key, in
# development, the links are printed in the server's log instead.
RESEND_API_KEY=""
EMAIL_FROM="Tread <bonjour@example.com>"

# Where the landing page lives, for the brand link.
NEXT_PUBLIC_LANDING_URL="http://localhost:3021"
