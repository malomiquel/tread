{
  "name": "tread",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "pnpm --filter @tread/mobile start",
    "web": "pnpm --filter @tread/web dev",
    "landing": "pnpm --filter @tread/landing dev",
    "ios": "pnpm --filter @tread/mobile ios",
    "android": "pnpm --filter @tread/mobile android",
    "deploy:ios": "pnpm --filter @tread/mobile deploy:ios",
    "install:ios": "pnpm --filter @tread/mobile install:ios",
    "release:ios": "pnpm --filter @tread/mobile release:ios",
    "release:android": "pnpm --filter @tread/mobile release:android",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
