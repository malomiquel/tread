# Copy to .env (never committed). Supabase → Project settings → Database → Connect.
# Pooled (transaction pooler, port 6543): what the app uses.
DATABASE_URL="postgresql://tread_app.PROJECT_REF:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Session pooler (port 5432): what migrations use (the direct host is IPv6 only).
DIRECT_URL="postgresql://tread_app.PROJECT_REF:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"
