{
  "name": "@tread/db",
  "version": "1.0.0",
  "private": true,
  "description": "Tread's server database: the Prisma schema, its migrations and the client. Server only, never in the phone app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev && prisma generate",
    "deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.2.0",
    "prisma": "7.10.1",
    "typescript": "~6.0.3"
  }
}
